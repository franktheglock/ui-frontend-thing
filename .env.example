# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Local Model Providers
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234

# Search Providers
BRAVE_API_KEY=
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=
SEARXNG_URL=http://localhost:8080

# Server Configuration
PORT=3456
# Bind address. Default 127.0.0.1 (loopback only). Use 0.0.0.0 only with API_AUTH_TOKEN.
HOST=127.0.0.1
DATA_DIR=./data
SKILLS_DIR=./skills
NODE_ENV=development

# Security
# Optional for bare-metal (localhost). Required for Docker Compose (see docker-compose.yml).
# Overrides Settings → Network token when set.
# API_AUTH_TOKEN=
# Prefer enabling LAN from the UI: Settings → General → Network
# (optional token requirement can be turned off there on trusted LANs)
# CORS_ORIGINS=http://localhost:3456,http://127.0.0.1:3456
# FRONTEND_ORIGIN=http://localhost:3456

# Host-execution tools (NOT sandboxed). Opt-in only.
# ENABLE_TERMINAL_TOOL=true
# ENABLE_PYTHON_TOOL=true
# ENABLE_MCP_STDIO=true

# Optional HTTPS proxy for browser extension (see https-proxy.mjs).
# Defaults to 127.0.0.1 only; set PROXY_HOST=0.0.0.0 only with a LAN/API token.
# PROXY_PORT=5184
# PROXY_HOST=127.0.0.1

# Hermes proxy: by default only loopback base URLs are allowed
# HERMES_ALLOW_REMOTE=false
