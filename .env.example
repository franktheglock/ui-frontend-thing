# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Local Model Providers
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234

# Search Providers
BRAVE_API_KEY=
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=
SEARXNG_URL=http://localhost:8080

# Server Configuration
PORT=3456
# Bind address. Default 127.0.0.1 (loopback only). Use 0.0.0.0 only with API_AUTH_TOKEN.
HOST=127.0.0.1
DATA_DIR=./data
SKILLS_DIR=./skills
NODE_ENV=development

# Security
# Optional: force a token for ALL clients (overrides Settings → Network token).
# API_AUTH_TOKEN=
# Prefer enabling LAN from the UI: Settings → General → Network
# (optional token requirement can be turned off there on trusted LANs)
# STRICT_LOCAL_ONLY=false
# CORS_ORIGINS=http://localhost:3456,http://127.0.0.1:3456
# FRONTEND_ORIGIN=http://localhost:3456

# Host-execution tools (not sandboxed — disable if you don't need them)
# ENABLE_TERMINAL_TOOL=true
# ENABLE_PYTHON_TOOL=true
# ENABLE_MCP_STDIO=true

# Hermes proxy: by default only loopback base URLs are allowed
# HERMES_ALLOW_REMOTE=false
